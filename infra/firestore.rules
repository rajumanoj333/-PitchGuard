rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Brain-written collections — clients read-only.
    match /decisions/{id}   { allow read: if true; allow write: if false; }
    match /zones/{id}       { allow read: if true; allow write: if false; }
    match /live/{id}        { allow read: if true; allow write: if false; }
    match /alerts/{id}      { allow read: if true; allow write: if false; }

    // Fan heartbeat — any fan can write their own doc with limited fields.
    // Demo: open writes. Production: lock to App Check + Firebase Auth.
    match /fans/{fanId} {
      allow read: if true;
      allow write: if
           request.resource.data.keys().hasOnly(['name','zone','lat','lng','accuracy','ts','ua'])
        && request.resource.data.name.size() < 60
        && request.resource.data.zone in ['NORTH','EAST','SOUTH','WEST']
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow delete: if true;
    }

    // Fan reports (lost item, medical, etc): authed users may create.
    match /reports/{id} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['type','message','geo','ts'])
        && request.resource.data.message.size() < 280;
      allow update, delete: if false;
    }
  }
}
